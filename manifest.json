{
  "manifest_version": 3,
  "name": "NameTrace",
  "version": "2.1.4",
  "description": "Hover any name on an article (Wikipedia, news, blogs) to see their full name and the sentence they were first introduced in.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.wikipedia.org/*",
        "*://*.medium.com/*",
        "*://*.substack.com/*",
        "*://*.nytimes.com/*",
        "*://*.washingtonpost.com/*",
        "*://*.wsj.com/*",
        "*://*.bbc.com/*",
        "*://*.bbc.co.uk/*",
        "*://*.theguardian.com/*",
        "*://*.apnews.com/*",
        "*://*.reuters.com/*",
        "*://*/*"
      ],
      "exclude_matches": [
        "*://*.google.com/*",
        "*://*.github.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.amazon.com/*"
      ],
      "js": [
        "src/constants.js",
        "src/site.js",
        "src/detect.js",
        "src/cast.js",
        "src/resolve.js",
        "src/wrap.js",
        "src/tooltip.js",
        "src/content.js"
      ],
      "css": ["styles/tooltip.css"],
      "run_at": "document_idle"
    }
  ]
}
